rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function primaryProfile(uid) {
      return /databases/(default)/documents/Usuarios/$(uid);
    }

    function legacyProfile(uid) {
      return /databases/(default)/documents/usuarios/$(uid);
    }

    function hasProfile(uid) {
      return firestore.exists(primaryProfile(uid))
        || firestore.exists(legacyProfile(uid));
    }

    function profilePath(uid) {
      return firestore.exists(primaryProfile(uid))
        ? primaryProfile(uid)
        : legacyProfile(uid);
    }

    function activeUser() {
      return signedIn()
        && hasProfile(request.auth.uid)
        && firestore.get(profilePath(request.auth.uid)).data.activo == true;
    }

    function isAdmin() {
      return activeUser()
        && request.auth.uid in [
          'g5hYmFofzdhobnW72lz9gnEWQBq1',
          'QSFhObd4G1gZogI0NtZhqCg778c2'
        ]
        && firestore.get(profilePath(request.auth.uid)).data.rol
          in ['admin', 'administrador'];
    }

    match /evidencias/{userId}/{fileName} {
      allow read, delete: if activeUser()
        && (request.auth.uid == userId || isAdmin());
      allow create, update: if activeUser()
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }
  }
}
