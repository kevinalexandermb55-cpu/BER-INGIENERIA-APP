rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile(uid) { return exists(/databases/$(database)/documents/usuarios/$(uid)); }
    function profile(uid) { return get(/databases/$(database)/documents/usuarios/$(uid)).data; }
    function activeUser() { return signedIn() && hasProfile(request.auth.uid) && profile(request.auth.uid).activo == true; }
    function adminConfigured() {
      let path = /databases/$(database)/documents/config/berSecurity;
      return exists(path)
        && get(path).data.adminUid1 is string
        && get(path).data.adminUid2 is string
        && get(path).data.adminUid1 != get(path).data.adminUid2
        && request.auth.uid in [get(path).data.adminUid1, get(path).data.adminUid2];
    }
    function isAdmin() {
      return activeUser() && profile(request.auth.uid).rol == 'admin'
        && adminConfigured();
    }

    // This document is provisioned only by the Firebase project owner in Console.
    match /config/{configId} {
      allow read, write: if false;
    }

    match /usuarios/{userId} {
      // Anyone with an authenticated account may create only their own engineer profile.
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','email','nombre','rol','activo','creadoEn'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol == 'ingeniero'
        && request.resource.data.activo == true;
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if (isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','activo','actualizadoEn'])
          && (resource.data.rol != 'admin' || request.resource.data.activo == resource.data.activo))
        || (activeUser() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.activo == resource.data.activo);
      allow delete: if false;
    }

    match /actividades/{activityId} {
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['uid','emailEmpleado','nombreEmpleado','fecha','titulo','ubicacion','descripcion','evidencias','creadoPor','creadoEn'])
        && request.resource.data.uid is string
        && request.resource.data.emailEmpleado is string
        && request.resource.data.fecha is string
        && request.resource.data.titulo is string
        && request.resource.data.descripcion is string
        && request.resource.data.evidencias is list
        && request.resource.data.creadoPor == request.auth.uid
        && ((isAdmin() && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.uid))) || request.resource.data.uid == request.auth.uid);
      allow get, list: if activeUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /asientos/{asientoId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actividadId','fecha','tipoDocumento','nombreDocumento','numeroDocumento','beneficiario','identificacion','concepto','lineas','debitoTotal','creditoTotal','estado','creadoPor','creadoEn','actualizadoEn'])
        && request.resource.data.actividadId is string
        && exists(/databases/$(database)/documents/actividades/$(request.resource.data.actividadId))
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.lineas is list
        && request.resource.data.debitoTotal is number
        && request.resource.data.creditoTotal is number
        && request.resource.data.estado in ['borrador','listo']
        && (request.resource.data.estado == 'borrador' || request.resource.data.debitoTotal == request.resource.data.creditoTotal);
      allow update: if isAdmin()
        && request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.actividadId == resource.data.actividadId
        && request.resource.data.estado in ['borrador','listo']
        && (request.resource.data.estado == 'borrador' || request.resource.data.debitoTotal == request.resource.data.creditoTotal);
      allow delete: if isAdmin() && resource.data.estado == 'borrador';
    }
  }
}
