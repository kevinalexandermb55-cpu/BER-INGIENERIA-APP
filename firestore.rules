rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Lista cerrada de propietarios autorizados por UID de Firebase Auth.
    function trustedAdmin(uid) {
      return uid in [
        'g5hYmFofzdhobnW72lz9gnEWQBq1',
        'QSFhObd4G1gZogI0NtZhqCg778c2'
      ];
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(uid));
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function activeUser() {
      return signedIn()
        && profileExists(request.auth.uid)
        && profile(request.auth.uid).activo == true;
    }

    function isAdmin() {
      return activeUser()
        && (
          trustedAdmin(request.auth.uid)
          || profile(request.auth.uid).rol in ['admin', 'administrador']
        );
    }

    match /usuarios/{userId} {
      // Cada cuenta solo puede crear su propio perfil.
      // Los dos UID propietarios pueden crearlo como administrador.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.activo == true
        && (
          (trustedAdmin(request.auth.uid)
            && request.resource.data.rol in ['admin', 'administrador'])
          ||
          (!trustedAdmin(request.auth.uid)
            && request.resource.data.rol == 'empleado')
        );

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      // El propietario puede completar su UID. Solo los UID de confianza
      // pueden corregir su propio rol administrativo; otros no pueden elevarse.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.activo == resource.data.activo
          && (
            (
              trustedAdmin(request.auth.uid)
              && request.resource.data.rol in ['admin', 'administrador']
            )
            ||
            (
              !trustedAdmin(request.auth.uid)
              && request.resource.data.rol == resource.data.rol
            )
          )
        );

      allow delete: if isAdmin();
    }

    // Colección que utiliza la versión actual de app.js.
    match /actividades/{activityId} {
      allow create: if activeUser()
        && request.resource.data.uid is string
        && request.resource.data.fecha is string
        && request.resource.data.titulo is string
        && request.resource.data.descripcion is string
        && (
          (isAdmin() && request.resource.data.creadoPor == request.auth.uid)
          ||
          (!isAdmin() && request.resource.data.uid == request.auth.uid
            && request.resource.data.creadoPor == request.auth.uid)
        );

      allow read: if activeUser()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow update: if isAdmin();

      allow delete: if activeUser()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Se conserva compatibilidad con datos antiguos de la colección movimientos.
    match /movimientos/{movementId} {
      allow create: if activeUser()
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.tipo in ['viatico', 'gasto']
        && request.resource.data.fecha is string
        && request.resource.data.categoria is string
        && request.resource.data.descripcion is string
        && (
          (isAdmin() && request.resource.data.uid is string)
          || (request.resource.data.tipo == 'gasto'
              && request.resource.data.uid == request.auth.uid)
        );

      allow read: if activeUser()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();
    }
  }
}
