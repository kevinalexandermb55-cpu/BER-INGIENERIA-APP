rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function primaryProfilePath(uid) {
      return /databases/$(database)/documents/Usuarios/$(uid);
    }
    function legacyProfilePath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }
    function hasProfile(uid) {
      return exists(primaryProfilePath(uid)) || exists(legacyProfilePath(uid));
    }
    // The historical uppercase collection is canonical; lowercase is supported for existing records.
    function profile(uid) {
      return exists(primaryProfilePath(uid))
        ? get(primaryProfilePath(uid)).data
        : get(legacyProfilePath(uid)).data;
    }
    function activeUser() {
      return signedIn() && hasProfile(request.auth.uid)
        && profile(request.auth.uid).activo == true;
    }
    function hasAdminRole(uid) {
      return profile(uid).rol in ['admin', 'administrador'];
    }
    function adminConfigured() {
      let path = /databases/$(database)/documents/config/berSecurity;
      return exists(path)
        && get(path).data.adminUid1 is string
        && get(path).data.adminUid2 is string
        && get(path).data.adminUid1 != get(path).data.adminUid2
        && request.auth.uid in [get(path).data.adminUid1, get(path).data.adminUid2];
    }
    function isAdmin() {
      return activeUser() && hasAdminRole(request.auth.uid)
        && adminConfigured();
    }
    function canCreateProfile(userId) {
      return signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','email','nombre','rol','activo','creadoEn'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol == 'ingeniero'
        && request.resource.data.activo == true;
    }
    function canUpdateProfile(userId) {
      return (isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','activo','actualizadoEn'])
          && (!hasAdminRole(userId) || request.resource.data.activo == resource.data.activo))
        || (activeUser() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.activo == resource.data.activo);
    }

    match /config/{configId} {
      allow read, write: if false;
    }

    // Keep both spellings readable so existing records are not lost; the app writes new profiles to `Usuarios`.
    match /Usuarios/{userId} {
      allow create: if canCreateProfile(userId);
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if canUpdateProfile(userId);
      allow delete: if false;
    }
    match /usuarios/{userId} {
      allow create: if canCreateProfile(userId);
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if canUpdateProfile(userId);
      allow delete: if false;
    }

    match /actividades/{activityId} {
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['uid','emailEmpleado','nombreEmpleado','fecha','titulo','ubicacion','descripcion','evidencias','creadoPor','creadoEn'])
        && request.resource.data.uid is string
        && request.resource.data.emailEmpleado is string
        && request.resource.data.fecha is string
        && request.resource.data.titulo is string
        && request.resource.data.descripcion is string
        && request.resource.data.evidencias is list
        && request.resource.data.creadoPor == request.auth.uid
        && ((isAdmin() && hasProfile(request.resource.data.uid)) || request.resource.data.uid == request.auth.uid);
      allow get, list: if activeUser()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }